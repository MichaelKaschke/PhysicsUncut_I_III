@entry{aero_Bahnlinie,
  name={Bahnlinie},
  symbol={},
  description={In einem Str\"omungsfeld gibt eine Bahnlinie eine Ortskurve an,
  die ein Materiepunkt mit der Zeit tats\"achlich durchl\"auft.}
}

@entry{aero_viskositaet,
  name={Viskosität},
  symbol={},
  description={Die Viskosität ist die Zähflüssigkeit oder Zähigkeit von Flüssigkeiten und Gasen (Fluiden). Sie bemisst den Widerstand, den ein fließfähiges (vorwiegend flüssiges oder gasförmiges) Stoffsystem seiner irreversiblen Verformung entgegensetzt. Sie ist um so größer, je mehr Spannung aufgebracht werden muss, um eine bestimmte Verformungsgeschwindigkeit zu erreichen.}
}

@entry{aero_eulerscheKoordinaten,
  name={Euler-Koordinaten},
  symbol={},
  description={In der Kontinuumsmechanik ordnen Euler-Koordinaten jedem
  festen Materiepunkt $\vec{\hat{P}}$ zu jedem Zeitpunkt $t$ einen Ort $\vec{r}$
  zu. Sie geben also an, wo sich ein Materiepunkt befindet, $\vec{r}
  (\vec{\hat{P}},t)$.}
}

@entry{aero_Dispersionsrelation,
  name={Dispersionsrelation},
  symbol={},
  description={In der Physik beschreibt die Dispersionsrelation den Zusammenhang zwischen der Energie eines physikalischen Prozesses (gegeben durch Frequenz \bzw Energie) und den Prozessablauf beschreibenden Gr\"o\ss en wie Wellenzahl, der Ausbreitungsgeschwindigkeit u.\,a.). Mathematisch wird die Dis\-persions\-relation bei Wellen aus der linearen Wellengleichung durch eine Fourier-Transformation in Raum und Zeit gewonnen und hat die allgemeine Form:
	$\omega = f(k)$ \bzw $\omega = f(\lambda)$, worin $\omega$ die Kreisfrequenz des schwingenden, energetischen Systems ist.}
}

@entry{FAA,
  name={FAA},
  symbol={},
  description={Die Federal Aviation Administration (FAA; deutsch „Bundesluftfahrtverwaltung“) ist die Bundesluftfahrtbehörde der Vereinigten Staaten und ist als Behörde ein administrativer Teil des US-Verkehrsministeriums mit Sitz in Washington, D.C. im Mike Monroney Aeronautical Center.}
}

@entry{aero_lagrangescheKoordinaten,
  name={Lagrange-Koordinaten},
  symbol={},
  description={Lagrange-Koordinaten geben an, welcher Materiepunkt
  $\vec{\hat{P}}$ sich zu einer bestimmten Zeit $t$ an einem bestimmten Ort $\vec{r}$
  befindet, $\vec{\hat{P}}(\vec{r},t)$. Sie entsprechen der Umkehrung der Euler-Koordinaten.}
}

@entry{aero_reynoldszahl,
  name={Reynolds-Zahl},
  symbol={Re},
  description={Dimensionslose Verh\"altniszahl, die bei
  Gr\"o\ss{}en\-skalierungen f\"ur identische Str\"omungsvorg\"ange konstant
  gehalten werden muss.}
}

@entry{aero_Stromlinie,
  name={Stromlinie},
  symbol={},
  description={Als Stromlinie in einem Str\"omungsfeld bezeichnet man eine
  Linie, die zu einem festen Zeitpunkt an jedem ihrer Punkte tangential an
  das Geschwindigkeitsfeld anliegt.}
}
