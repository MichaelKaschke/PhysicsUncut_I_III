@entry{bahnpar,
  name={Bahnparameter},
  symbol={$p = \frac{ L^2}{ m_\text{eff}\: \kappa}$},
  description={Geometrischer Parameter der Ellipse, der bei Zentralkraftfeldern direkt mit dem Drehimpuls\index{Drehimpuls} korreliert ist.}
}
@entry{ballistik,
  name={Ballistik},
  description={Teilbereich der Physik, der sich mit geworfenen K\"orpern besch\"aftigt.}
}
@entry{bewglg,
  name={Bewegungsgleichung},
  plural={Bewegungsgleichungen},
  symbol={},
  description={Die Bewegungsgleichung eines mechanischen Systems
ist die vollst\"andige Beschreibung seiner r\"aumlich-zeitlichen Entwicklung.
Meist ist das Raum-Zeit-Verhalten eines Aufbaus \"uber ein DGL-System angegeben.
Dessen L\"osungen (die selten einfach zu finden sind) sind dann die Bewegungsgleichungen.}
}
@entry{coulpot,
  name={Coulomb-Potential},
  symbol={$U(r)$},
  description={$U(r)=-\alpha/r$, elektrostatisches Potential von Ladungen}
}
@entry{exzentr,
  name={Exzentrizit\"at oder auch Elliptizit\"at},
  symbol={$e, \epsilon$},
  description={In der Mathematik bezeichnet die \emph{lineare Exzentrizit\"at} $\bar{e}$ den Abstand eines Brennpunkts zum Mittelpunkt einer Ellipse oder Hyperbel.
Die numerische Exzentrizit\"at entspricht dem Verh\"altnis aus linearer Exzentrizit\"at $\bar{e}$ und der L\"ange der gro{\ss}en Halbachse $a$, also $e\!=\!\bar{e}/a$.
F\"ur eine Ellipse gilt dabei $0\!\leq\! e\!\leq\! 1$.
F\"ur eine Hyperbel gilt $e\!>\!1$ und f\"ur eine Parabel $e\!=\!1$. In der Mechanik und insbesondere Himmelsmechanik wird mit $e$ \ia die (dimensionslose) numerische Exzentrizit\"at \bzw Elliptizit\"at bezeichnet.}
}

@entry{eigenvektor,
  name={Eigenvektor},
  symbol={$\vec{n}$},
  description={Wenn man Matrizen als Abbildung von Vektoren betrachtet, dann sind die Eigenvektoren der Matrix (Abbildung) die von einem Nullvektor verschiedenen Vektoren, deren Richtung durch die Abbildung nicht ver\"andert wird. Sie werden lediglich gestreckt. Der Skalierungsfaktor ist der Eigenwert der Abbildung.}
}
@entry{forminvar,
  name={Forminvarianz},
  symbol={},
  description={Eine Gleichung, die ihre Form durch eine Koordinatentransformation nicht \"andert, hei{\ss}t forminvariant.}
}
@entry{frequenzantwort,
  name={Frequenzantwort},
  symbol={},
  description={Die Frequenzantwort eines Systems ist das quantitative Verh\"altnis des Ausgangssignals in Amplitude und Phase bezogen auf das Eingangssignal in Abh\"angigkeit von der jeweiligen Frequenz des Eingangssignals.}
}
@entry{hamiltonfkt,
  name={Hamilton-Funktion},
  symbol={$\mathcal{H}$},
  description={Funktion, die aus der Lagrange-Funktion gebildet wird.
F\"ur konservative System entspricht sie der Summe von kinetischer und potentieller Energie, und damit Gesamtenergie des Systems.
  }
}
@entry{impuls,
  name={Impuls, generalisierter \bzw kanonischer},
  symbol={$p_j = \frac{\d \mathcal{L}}{\d \dot{q}_j}$},
  description={Impuls, der durch generalisierte \bzw verallgemeinerte Koordinaten beschrieben wird.}
}
@entry{inertsys,
  name={Inertialsystem},
  symbol={$\vec{\Sigma}$},
  description={Koordinatensystem, in dem ein kr\"aftefreier K\"orper ruht oder sich gleichf\"ormig bewegt}
}
@entry{integralgleichung,
  name={Integralgleichung},
  symbol={},
  description={Eine Gleichung oder Differentialgleichung wird Integralgleichung genannt, wenn die gesuchte Funktion auch unter einem Integral vorkommt.}
}

@entry{genkoord,
  name={Koordinate, generalisierte \bzw verallgemeinerte (und deren Ableitung)},
  symbol={$ q_j, \dot{q}_j $},
  description={Generalisierte Koordinaten werden als unabh\"angige Parameter entsprechend der Anzahl der Freiheitsgrade definiert und sind nicht mehr durch Zwangsbedingungen eingeschr\"ankt.}
}

@entry{zykkoord,
  name={Koordinate, zyklische},
  symbol={},
  description={Eine zyklische Koordinate $q_j$ ist eine Koordinate, bei der die Lagrange-Funktion eines Systems nicht explizit von $\dot{q}_j$ abh\"angt.
Daraus folgt $\dot{p_j}=0$ was bedeutet, dass der zugeh\"orige generalisierte Impuls eine Erhaltungsgr\"o{\ss}e ist.}
}

@entry{kos,
  name={Koordinatensystem},
  symbol={KOS},
  description={Ein geometrisches Referenzsystem mithilfe dessen die Position eines Objektes in einem endlich-dimensionalen Vektorraum eindeutig bestimmt werden kann.}
}
@entry{ons,
  name={Koordinatensystem, orthonormal},
  symbol={},
  description={KOS, bei dem die Basisvektoren orthogonal und normiert sind.}
}
@entry{disskr,
  name={Kraft, dissipative},
  symbol={$\vec{F}^\text{diss}$},
  description={Kraft die einem mechanischen System mechanische Energie entzieht und unumkehrbar in W\"arme umwandelt.
Dissipative Kr\"afte h\"angen im Gegensatz zu konservativen Kr\"aften im Allgemeinen von der Geschwindigkeit ab.
  }
}
@entry{konservkr,
  name={Kraft, konservative},
  symbol={$\vec{F}^\text{kons} $},
  description={Kraft eines konservativen Systems, \dh einem System, in dem die kinetische Energie erhalten bleibt.
Im Gegensatz zu dissipativen Kr\"aften h\"angen konservative Kr\"afte nur vom Potential ab, \dh auf einem beliebigen geschlossenen Weg durch das Kraftfeld (z.B. elektrisches Feld, Gravitationsfeld) wird in Summe keine Arbeit verrichtet.
  }
}
@entry{lagrfkt,
  name={Lagrange-Funktion},
  symbol={$\mathcal{L}$},
  description={Die Lagrange-Funktion beschreibt die Differenz zwischen der kinetischen Energie und der potentiellen Energie.
Mithilfe der Lagrange-Funktion k\"onnen viele mechanische Systeme besonders elegant beschrieben werden.
  }
}
@entry{lagrmult,
  name={Lagrange-Multiplikator},
  symbol={$\lambda$},
  description={Proportionalit\"atsfaktor, mit dem die Zwangsbedingungen in die Bewegungsgleichungen eingehen.}
}
@entry{potential,
  name={Potential, \newline potentielle Energie},
  symbol={$U$},
  description={Das Potential ist eine physikalische Gr\"o{\ss}e zur Beschreibung der Wirkung eines Feldes auf Massen.
In einem konservativen Kraftfeld (\zb elektrisches Feld, Gravitationsfeld) ergibt sich aus dem Gradienten des Potentials die Kraft und aus der Potentialdifferenz die Arbeit.
  }
}
@entry{com,
  name={Schwerpunkt},
  symbol={S, CoM},
  description={Der Schwerpunkt (auch Massenmittelpunkt) eines K\"orpers ist das mit der Gesamtmasse gewichtete Mittel der Positionen aller seiner Massepunkte. Im englischen wird er oft als Center of Mass (CoM) bezeichnet.}
}
@entry{comsys,
  name={Schwerpunktsystem},
  symbol={CoM-System},
  description={Bezugssystem, in dem der Schwerpunkt des betrachteten physikalischen Systems im Koordinatenursprung ruht.}
}
@entry{traj,
  name={Trajektorie},
  symbol={},
  description={Bahn, auch Bahnkurve, Pfad oder Weg (Englisch: \textit{Orbit}), ist der Verlauf der Kurve im Raume, entlang der sich ein K\"orper oder ein Massepunkt bewegt. Im erweiterten Sinn (Lagrange-Formalismus) ist die Trajektorie eine Kurve im n-dimensionalen Phasenraum. Mathematisch ergeben sich die Trajektorien als L\"osungen von Differentialgleichungen bzw. Differentialgleichungenssystemen.
  }
}
@entry{zwangsbed,
  name={Zwangsbedingung},
  symbol={},
  description={Eine Zwangsbedingung ist eine Bewegungseinschr\"ankung in einem mechanischen System, durch die die Zahl der Freiheitsgrade abnimmt. \emph{Holonom-skleronome Zwangsbedingungen} h\"angen im Gegensatz zu \emph{holonom-rheonomen} nicht explizit von der Zeit ab. \emph{Nicht-holonome Zwangsbedingungen} reduzieren die Zahl der Koordinaten nicht, \zb weil sie Ungleichungen sind.
  }
}
@entry{zwangskr,
  name={Zwangskraft},
  symbol={},
  description={Kraft, die aus Zwangsbedingungen resultiert.}
}
@entry{baroHoeheBew,
  name={Höhenformel, barometrische},
  symbol={},
  description={Die barometrische H\"ohenformel beschreibt den Zusammenhang zwischen H\"ohe und Luftdruck. Eine einfache Modellannahme ist ein vertikaler, negativer Druckgradient von einem Hektopascal je acht Meter H\"ohe.}
}

