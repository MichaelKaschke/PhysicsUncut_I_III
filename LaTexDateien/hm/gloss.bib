@entry{abstknoten,
  name={Absteigender Knoten},
  symbol={$\descnode$},
  description={Bahnpunkt, in dem ein Himmelsk\"orper die Ekliptik von Norden nach S\"uden durchquert.}
}

@entry{analemma,
  name={Analemma},
  %symbol={},
  description={Figur, die der Sonnenstand bei konstanter mittlerer Ortszeit erzeugt.
Diese Figur entsteht zum Beispiel durch Fotos der Sonne, die man t\"aglich zur selben mittleren Ortszeit (MOZ) \"uber ein Jahr hinweg macht. Plural: Analemmas oder Analemmata.
  }
}

@entry{anomjahr,
  name={Anomalistisches Jahr},
  %symbol={},
  description={Zeit zwischen zwei Durchg\"angen der Erde durch das Perihel.
Es entspricht daher der mittleren Bahnperiode der Erde.
Als Referenz f\"ur die Dauer eines anomalistischen Jahres wird der 01.\,01.\,2000 verwendet (Epoche J2000.0).
Das anomalistische Jahr hatte zu diesem Zeitpunkt eine L\"ange von $365.25963588$ Sonnentagen.
  }
}

@entry{aphel,
  name={Aphel},
  description={Sonnenfernster Punkt einer elliptischen Bahn um die Sonne (Griechisch apo - fern, helios - Sonne).}
}
@entry{perihel,
  name={Perihel},
  description={Sonnenn\"achster Punkt einer elliptischen Bahn um die Sonne (Griechisch/Neulatein peri - nah, helios - Sonne).}
}
@entry{apoapsis,
  name={Apoapsis},
  %symbol={},
  description={Hauptscheitel der elliptischen Umlaufbahn eines Himmelsk\"orpers mit der gr\"o\ss{}ten Entfernung zu einem Zentralk\"orper.
Im spezifischen Fall der Sonne entspricht dies dem Aphel.
  }
}
@entry{apsidenlinie,
  name={Apsidenlinie},
  %symbol={},
  description={Hauptscheitel der elliptischen Umlaufbahn eines Himmelsk\"orpers mit der gr\"o\ss{}ten Entfernung (sog.\ Apoapsis) oder kleinsten Entfernung (sog.\ Periapsis) zu einem Zentralk\"orper.
  }
}
@entry{aequator,
  name={\"Aquator},
  description={Ebene senkrecht zur Rotationsachse.}
}
@entry{aequinox,
  name={\"Aquinoktium \newline (des Datums)},
  %symbol={},
  description={Schnittpunkt des Himmels\"aquators mit der Ekliptik (zum Beobachtungszeitpunkt).
Im b\"urgerlichen Sprachgebrauch ist das \"Aquinoktium auch als Tagundnachtgleiche bekannt, \dh an diesen beiden Kalendertagen im Jahr ist der lichte Tag in etwa so lang wie die Nacht.
  }
}
@entry{argperiapsis,
  name={Argument der Periapsis \newline (des Perihels)},
  symbol={$\omega$},
  description={Eines der sechs Bahnelemente zur Definition des Orts einer Keplerellipse im Raum.
Der Winkel legt die Orientierung der Apoasis (gro\ss{}e Halbachse) fest.
Er wird vom aufsteigenden Knoten entlang der Bahnebene bis zur Periapsis (kleine Halbachse) gemessen.
  }
}
@entry{ae,
  name={Astronomische Einheit},
  symbol={AE},
  description={Die Astronomische Einheit (engl.\ astronomical unit = a.u.) ist eines der wichtigsten Einheiten/L\"angenma\ss{}e in der Astronomie.
Laut Definition ist eine AE exakt $\SI{149\,597\,870\,700}{\metre}$.
Das entspricht ungef\"ahr dem mittleren Abstand zwischen Erde und Sonne.
  }
}
@entry{tai,
  name={Atomzeit},
  symbol={TAI},
  description={Die Atomzeit (TAI f\"ur franz\"osisch Temps Atomique International) ist eine auf der Atomsekunde basierende Zeitskala. Die Realisierung der Atomzeit erfolgt in der Regel durch C\"asium-Atomuhren. In Deutschland wird die Atomzeit durch die Physikalisch-Technische Bundesanstalt (PTB) ermittelt.
  }
}
@entry{aufstknoten,
  name={Aufsteigender Knoten},
  symbol={$\ascnode$},
  description={Bahnpunkt, in dem ein Himmelsk\"orper die Ekliptik von S\"uden nach Norden durchquert.}
}
@entry{azimut,
  name={Azimut},
  symbol={$\mathcal{A}$},
  description={Ein nach einer Himmelsrichtung orientierter Horizontalwinkel und damit eine Koordinate, mit der ein Punkt an der Himmelskugel im horizontalen Koordinatensystem verortet werden kann. Der Winkel wird parallel zum Horizont gemessen.}
}
@entry{besselfkt,
  name={Bessel-Funktion},
  symbol={$\mathcal{J}$},
  description={$\mathcal{J}(z) = \frac{1}{\pi} \int\limits_0^\pi \cos (z\,\sin\theta - n\theta)\,\D \theta$}
}
@entry{dekl,
  name={Deklination},
  symbol={$\delta$},
  description={Der rechtwinklig zum \"Aquator gemessene Winkel zwischen einem Himmelsk\"orper und dem \"Aquator.
Die Deklination bildet zusammen mit der Rektaszension $\alpha$ die Koordinaten der \"aquatorialen Koordinatensysteme.
  }
}

@entry{legendrePol,
  name={Legendre-Polynome},
  symbol={$\PL n$},
  description={Die Legendre-Polynome, auch zonale Kugelfunktionen genannt, sind spezielle Polynome, die auf dem Intervall $[-1,1]$ ein orthogonales Funktionensystem bilden. Sie sind die partikul�ren L�sungen der Legendreschen Differentialgleichung. Die Legendre-Polynome spielen eine wichtige Rolle in der theoretischen Physik, insbesondere in der Gravitationstheorie, der Elektrodynamik und in der Quantenmechanik.
  }
}

@entry{drehimpuls,
  name={Drehimpuls},
  symbol={$\vec{L}$},
  description={Der Drehimpuls eines K\"orpers ist gegeben durch $\vec{L}\!=\! m\cdot\vec{r}\times\vec{v}$ mit der Masse $m$, dem Ortsvektor $\vec{r}$ und der vektoriellen Geschwindigkeit $\vec{v}\!\equiv\!\dot{\vec{r}}$.
In diesem Kapitel definieren wir ihn jedoch als massennormierten Parameter: $\vec{L}\rightarrow \vec{L}/m \:\Rightarrow\: \vec{L}\!=\! \vec{r}\times\dot{\vec{r}}$.
  }
}
@entry{ekliptik,
  name={Ekliptik},
  %symbol={},
  description={Derjenige gedachte Gro\ss{}kreis, der als Schnittlinie der Erdbahnebene mit der Himmelskugel entsteht.
Die Ekliptik dient als Bezugsebene f\"ur die ekliptikalen Koordinatensysteme mit den Koordinaten ekliptikale L\"ange ($l,\lambda$) und ekliptikale Breite ($b,\beta$).
  }
}

@entry{ekliptkoord,
  name={Ekliptikale Koordinaten},
  symbol={$l,\lambda,b,\beta$},
  description={Der Ort eines Himmelsk\"orpers relativ zur Ekliptik wird durch die heliozentrische \bzw geozentrische ekliptikale Breite $b,\beta$ und L\"ange $l,\lambda$ sowie das dazugeh\"orige \"Aquinoktium festgelegt.
Die ekliptikalen L\"angen $l,\lambda$ werden vom Fr\"uhlingspunkt aus l\"angs der Ekliptik nach Osten positiv gemessen.
Die ekliptikale Breite $b,\beta$ ist entsprechend der senkrecht zur Ekliptik gemessene Winkel zwischen einem Himmelsk\"orper und der Ekliptik.
  }
}

@entry{ekliptikschiefe,
  name={Ekliptikschiefe},
  symbol={$\epsilon$},
  description={Die Rotationsachse der Erde steht nicht senkrecht auf der Ebene der Erdbahn, sondern bildet mit ihr einen Winkel.
Dadurch schlie�t die \"Aquatorebene mit der ekliptikalen Ebene einen Winkel von derzeit $23.43653\degree$ ein.
  }
}

@entry{energie,
  name={Energie},
  symbol={$H$},
  description={Gesamtenergie eines K\"orpers als Summe aus kinetischer Energie $T$ und potentieller Energie $U$, also $H\!=\! T+U$.
In diesem Kapitel definieren wir die Energie als massennormierte Gr\"o�e $H \rightarrow H/m$. Um Verwechslungen mit der exzentrischen Anomalie zu vermeiden benutzt man in der Himmelsmechanik den Buchstaben $H$ anstelle des in der klassischen Mechanik \"ublichen $E$.}
}

@entry{entfernunghimmelskoerper,
  name={Entfernung zum Himmelsk\"orper},
  symbol={$\Delta,r$},
  description={Je nach Wahl des Koordinatensystems bezeichnen wir die Entfernung mit $\Delta$ (bei relativen Koordinatensystemen) oder $r$ (bei absoluten Koordinatensystemen).}
}

@entry{ephemeride,
  name={Ephemeride},
  description={Als Ephemeride wird die Positionsangabe eines Himmelsk\"orpers bezogen auf ein bestimmtes Koordinatensystem bezeichnet.}
}

@entry{epoche,
  name={Epoche},
  description={Mit Epoche wird der Zeitpunkt einer Beobachtung oder eines Vorgangs bezeichnet.}
}

@entry{et,
  name={Ephemeridenzeit},
  symbol={ET},
  description={Eine gleichf\"ormig ablaufende Zeitz\"ahlung, die zur Berechnung der Koordinaten eines Planeten, Kometen oder Asteroiden benutzt wird.
  }
}

@entry{exzentr-hm,
  name={Exzentrizit\"at},
  symbol={$e$},
  description={In der Mathematik bezeichnet die \emph{lineare Exzentrizit\"at} $\bar{e}$ den Abstand eines Brennpunkts zum Mittelpunkt einer Ellipse oder Hyperbel.
In der Astronomie ist hingegen mit \anf{Exzentrizit\"at} meist die dimensionslose \emph{numerische Exzentrizit\"at} $e$ gemeint.
Die numerische Exzentrizit\"at entspricht dem Verh\"altnis aus linearer Exzentrizit\"at $\bar{e}$ und der L\"ange der gro�en Halbachse $a$, also $e\!=\!\bar{e}/a$.
F\"ur eine Ellipse gilt dabei $0\!\leq\! e\!\leq\! 1$.
Im Fall $e\!=\!0$ geht die Ellipse in einen Kreis \"uber.
F\"ur eine Hyperbel gilt $e\!>\!1$ und f\"ur eine Parabel $e\!=\!1$.
  }
}

@entry{exzentranom,
  name={Exzentrische Anomalie},
  symbol={$E$},
  description={Momentaner Winkel eines Himmelsk\"orpers zum zentrumsn\"achsten Punkt im umschriebenen Kreis.
Sie dient insbesondere zur L\"osung des Keplerproblems.
  }
}

@entry{fahrstrahl,
  name={Fahrstrahl},
  description={Als Fahrstrahl wollen wir die Verbindungslinie zwischen dem gravitativen Schwerpunkt eines Systems und der Position eines Planeten zum Zeitpunkt $t$ bezeichnen.}
}

@entry{fruehlingspunkt,
  name={Fr\"uhlingspunkt},
  symbol={\vernal},
  description={Schnittpunkt der Ekliptik mit dem \"Aquator, in dem die Sonne auf ihrer scheinbaren j\"ahrlichen Bahn den \"Aquator von S\"uden nach Norden \"uberschreitet.
Dies ist gegenw\"artig um den 21.~M\"arz jeden Jahres der Fall.
Der genaue Zeitpunkt dieses Ereignisses definiert den Beginn des Fr\"uhlings.
Der Fr\"uhlingspunkt bildet die Bezugsrichtung zur Z\"ahlung der ekliptikalen Koordinaten und der Rektaszension.
  }
}

@entry{geogrkoord,
  name={Geographische Koordinaten},
  symbol={$\varphi,\lambda$},
  description={Sph\"arisches KOS, dessen Winkel geographische Breite $\varphi$ und L\"ange $\lambda$ einen Ort auf der Erdoberfl\"ache eindeutig festlegen.
Als Bezugsebene der geographischen Breite dient der Erd\"aquator, w\"ahrend als Ausgangspunkt der Z\"ahlung der L\"ange der Meridian von Greenwich verwendet wird.
Die geographischen Koordinaten beziehen sich auf die tats\"achliche Lotrichtung am Messpunkt (Richtung senkrecht zum Horizont), die im Regelfall nicht durch den Erdmittelpunkt verl\"auft.
  }
}

@entry{geozentrkoord,
  name={Geozentrische Koordinaten},
  symbol={$\varphi',\lambda'$},
  description={Dreidimensionales kartesisches KOS, dessen Koordinatenursprung im Zentrum des Erdrotationsellipsoids liegt.
Die $z$-Achse verl\"auft in Richtung der Rotationsachse der Erde.
Die $x$-Achse zeigt in H\"ohe des \"Aquators auf den Nullmeridian (Greenwich), die $y$-Achse nach Osten.
Da sich das KOS mit der Erde dreht, kann der Punkt eines Ortes auf der Erdoberfl\"ache  durch die geozentrische L\"ange und Breite festlegt werden.
Wegen der Abplattung des Rotationsellipsoids unterscheidet sich die geozentrische $\varphi'$ von der geographischen Breite $\varphi$, w\"ahrend die L\"angen gleich sind.
  }
}

@entry{gnomon,
  name={Gnomon},
  description={Schattenstab f\"ur Sonnenuhren.}
}

@entry{gnomonik,
  name={Gnomonik},
  description={Lehre von der Sonnenuhren.}
}

@entry{gravkonst,
  name={Gravitationskonstante},
  symbol={$G$},
  description={$G = \lk 6.67259 \pm 0.00085\rk\,10^{-11}\SI{}{\meter\cubed\per\kg\per\second\squared}$
  }
}

@entry{gravizentrum,
  name={Gravizentrum},
  description={Mittel aller Positionen gewichtet nach der angreifenden Gravitationskraft im jeweiligen Punkt. F\"ur ein homogenes Gravitationsfeld stimmt das Gravizentrum mit dem Massenmittelpunkt des K\"orpers \"uberein. Man nennt diesen dann Schwerpunkt. Im Fall inhomogener Gravitationsfelder sind Gravizentrum und Massenmittelpunkt verschieden.}
}

@entry{groszehalbachse,
  name={Gro\ss{}e Halbachse der Ellipse},
  symbol={$a$},
  description={Zusammen mit der kleinen Halbachse $b$ definiert die gro\ss{}e Halbachse die Ellipse nach
  \begin{equation*}
	\frac{x^2}{a^2} + \frac{y^2}{b^2} =1~~.
	\end{equation*}
  }
}

@entry{jd,
  name={Julianisches Datum},
  symbol={JD},
  description={Tagesz\"ahlung, welche die Zeit in Tagen und Tagesbruchteilen angibt, die seit dem 01.\,01.\:- 4712 (also 4713 v. Chr.) um 12:00 UT vergangen ist.
Ein Julianisches Jahrhundert hat exakt 36525 Tage.
  }
}

@entry{ks,
  name={Kernschatten},
  symbol={KS},
  description={Bedeckungszone bei Sonnenfinsternis.}
}

@entry{kleinehalbachse,
  name={Kleine Halbachse der Ellipse},
  symbol={$b$},
  description={Zusammen mit der gro\ss{}en Halbachse $a$ definiert die kleine Halbachse $b= a(1-e^2)$ die Ellipse nach 
  \begin{equation*}
	\frac{x^2}{a^2} + \frac{y^2}{b^2} =1~~.
	\end{equation*}
  }
}

@entry{konj,
  name={Konjunktion eines Planeten},
  %symbol={},
  description={Als Konjunktion wird die scheinbare Begegnung zweier Himmelsk\"orper bezeichnet, insbesondere zweier Planeten oder eines Planeten mit Sonne oder Mond.
Dies bedeutet, dass beide Himmelsobjekte den gleichen Koordinatenwert in der Rektaszension erreichen.
  }
}

@entry{kos-hm,
  name={Koordinatensystem},
  symbol={KOS},
  description={Ein geometrisches Referenzsystem mithilfe dessen die Position eines Objektes in einem endlich-dimensionalen Vektorraum eindeutig bestimmt werden kann.}
}

@entry{kulmination,
  name={Kulmination},
  %symbol={},
  description={Der Moment, in dem ein Himmelsk\"orper seine gr\"o\ss{}te H\"ohe \"uber dem Horizont erreicht, \dh
 wenn der Himmelsk\"orper den Meridian passiert.
  }
}

@entry{laengeaufstknoten,
  name={L\"ange des aufsteigenden Knotens},
  symbol={$\Omega$},
  description={Die L\"ange des aufsteigenden Knotens einer Umlaufbahn um die Sonne ist der in der Ekliptik zu messende heliozentrische Winkel zwischen aufsteigendem Knoten $\ascnode$ und Fr\"uhlingspunkt $\vernal$.}
}

@entry{lineatur,
  name={Lineatur},
  description={Menge der vom Gnomon oder Nodus geworfenen Schatten auf einer Ziffernblattebene, auf der die Zeit abgelesen werden kann.}
}

@entry{meridian,
  name={Meridian},
  %symbol={},
  description={Gro\ss{}kreis an der Himmelskugel, der durch den Zenit des Beobachters l\"auft und den Horizont im Nordpunkt und im S\"udpunkt schneidet.
Alle Meridiane verlaufen durch die Erdpole und schneiden den \"Aquator unter einem rechten Winkel.
  }
}

@entry{mittelpunktsglg,
  name={Mittelpunktsgleichung},
  symbol={$\mathcal{C}$, \newline MPG},
  description={Als Mittelpunktsgleichung wird in der Astronomie die Abweichung der ungleichm\"a\ss{}igen Bewegung entlang einer Ellipse von einer gleichm\"a\ss{}igen Bewegung entlang einer Kreisbahn bezeichnet.
Sie berechnet sich sich aus der Kepler-Gleichung als Differenz zwischen mittlerer Anomalie $M$ und wahrer Anomalie $\upsilon$.
  }
}

@entry{mittlereanom,
  name={Mittlere Anomalie},
  symbol={$M$},
  description={Momentaner Winkel eines Himmelsk\"orpers zum zentrumsn\"achsten Punkt in einer fiktiv gleichf\"ormigen Bewegung.
Sie gibt den Umlauf zeitlich linear als erste N\"aherung an.
  }
}

@entry{gmst,
  name={Mittlere Greenwich Sternzeit},
  symbol={GMST},
  description={GMST, Greenwich Mean Sidereal Time, ist die mittlere Sternzeit f\"ur alle Orte, die auf dem gleichen Meridian wie Greenwich liegen.}
}

@entry{nadir,
  name={Nadir},
  symbol={N},
  description={Der dem Zenit genau gegen\"uberliegende Punkt auf der gedachten Himmelskugel.}
}

@entry{moz,
  name={Mittlere Ortszeit},
  symbol={MOZ},
  description={Die Zeit, die eine Sonnenuhr anzeigen w\"urde, wenn die Bahn der Erde um die Sonne ein Kreis w\"are.
Die Differenz zwischen WOZ und MOZ wird Zeitgleichung genannt.
  }
}

@entry{inklination,
  name={Neigung einer Bahn, Inklination},
  symbol={$i$},
  description={Einer der sechs Bahnparameter.}
}

@entry{nodus,
  name={Nodus},
  description={Spitze des Gnomons, auch Auge genannt.}
}

@entry{opposition,
  name={Opposition eines Planeten},
  %symbol={},
  description={Opposition ist in der Astronomie die Konstellation, bei der sich zwei Himmelsk\"orpers von der Erde aus betrachtet im Winkelabstand von 180 Grad zueinander befinden.
  }
}

@entry{parallaxe,
  name={Parallaxe},
  description={Nahe Himmelskörper verändern bei Wechsel der Beobachtungsposition scheinbar ihre Position relativ zum Fixsternhimmel. Diesen Effekt nennt man Parallaxe.}
}

@entry{periapsis,
  name={Periapsis},
  %symbol={},
  description={Hauptscheitel der elliptischen Umlaufbahn eines Himmelsk\"orpers mit der geringsten Entfernung zu einem Zentralk\"orper.
Im spezifischen Fall der Sonne entspricht dies dem Perihel.
  }
}
%
%@entry{perihel,
%  name={Perihel},
%  description={Sonnenn\"achster Punkt einer Planeten- oder Kometenbahn}
%}
%
@entry{periheldistanz,
  name={Periheldistanz},
  symbol={$q$},
  description={Kleinster Abstand eines Himmelsk\"orpers zum Zentralk\"orper}
}

@entry{potential-hm,
  name={Potential, \newline potentielle Energie},
  symbol={$U$},
  description={Das Potential in der Himmelsmechanik ist eine physikalische Gr\"o\ss{}e zur Beschreibung der Wirkung eines Kraftfeldes auf Massen.
In einem konservativen Kraftfeld (\zb elektrisches Feld, Gravitationsfeld) ergibt sich aus dem Gradienten des Potentials die Kraft und aus der Potentialdifferenz die Arbeit.
  }
}

@entry{reduktion,
  name={Reduktion},
  symbol={$\mathcal{R}$},
  description={Die Reduktion auf die Ekliptik ist erforderlich, da die Ebene, in der sich ein Himmelsk\"orper bewegt und entlang welcher daher die Bahnkoordinate gemessen wird, gegen die Ekliptikebene geneigt ist, entlang welcher die ekliptikale L\"ange gemessen wird.
Die deshalb erforderliche Umrechnung der Bahnkoordinate in die Ekliptikkoordinate kann durch eine Koordinatentransformation oder durch eine Reihenentwicklung erfolgen.
  }
}

@entry{refraktion,
  name={Refraktion},
  symbol={$R$},
  description={Durch Brechung von Lichtstrahlen in der Erdatmosph\"are verursachte Winkel\"anderung.
Dadurch erscheint ein Himmelsobjekt dem Beobachter auf der Erdoberfl\"ache in einer \anf{scheinbaren} H\"ohe, die ungleich der rein geometrisch betrachteten \anf{wahren} H\"ohe ist.
  }
}

@entry{rektasz,
  name={Rektaszension},
  symbol={$\alpha$},
  description={Koordinate des \"aquatorialen Koordinatensystems.
Die Rektaszension wird vom Fr\"uhlingspunkt aus l\"angs des \"Aquators nach Osten positiv gemessen.
  }
}

@entry{rf,
  name={Ringf\"ormige Finsternis},
  symbol={RF},
  description={Finsternis, bei der der Schatten des bedeckenden Himmelskörper den leuchtenden nicht vollständig überdeckt und somit eine ringförmige Struktur entstehenden kann.}
}

@entry{siderischeumlaufzeit,
  name={Siderische Umlaufzeit},
  symbol={$T_\text{sid}$},
  description={Zeitspanne, die ein Planet f\"ur einen vollen Umlauf vor dem Sternenhintergrund ben\"otigt.
Siderisch kommt von \emph{lat.} sidus, was \anf{Stern} bedeutet.
  }
}

@entry{synodischeumlaufzeit,
  name={Synodische Umlaufzeit},
  symbol={$T_\text{synod}$},
  description={Zeitspanne, die ein Planet von einer Oppositionsstellung \bzw Konjunktionsstellung zur n\"achsten ben\"otigt.
Synodisch kommt von \emph{altgriech.} synodos, was \anf{Zusammentreffen} bedeutet.
  }
}

@entry{sternzeit,
  name={Sternzeit},
  symbol={$\theta$},
  description={Rektaszension der Sterne, die ein Beobachter gerade im Meridian sieht.
Die Sternzeit kann sowohl als Zeit oder auch in Winkelma\ss{}en angegeben werden.
Ein Sterntag entspricht 360 $\degree$ und der Dauer einer Erdumdrehung, er dauert rund $23^\text{h}56^\text{m}$ UT.
  }
}

@entry{stundenwinkel,
  name={Stundenwinkel},
  symbol={$\tau$},
  description={Differenz zwischen der lokalen Sternzeit und der Rektaszension eines Himmelsk\"orpers.
Der Stundenwinkel ist damit ein Ma\ss{} f\"ur die Zeit, die seit der letzten Kulmination des Himmelsk\"orpers vergangen ist oder noch bis zur n\"achsten vergehen muss.
  }
}

@entry{tagbogen,
  name={Tagbogen},
  %symbol={},
  description={Winkelbogen der Bahn eines Himmelsk\"orpers, die \"uber dem Horizont des Beobachters verl\"auft.
Dr\"uckt man den Tagbogen im Zeitma\ss{} aus, so gibt er die in Sternzeit $\theta$ gemessene Zeit Aufgang \"uber Kulmination bis Untergang des Himmelsk\"orpers an.
  }
}

@entry{tf,
  name={Totale Finsternis},
  symbol={TF},
  description={Finsternis, bei der der Schatten des bedeckenden Himmelskörpers den sichtbaren vollständig überdeckt.}
}

@entry{tropischesjahr,
  name={Tropisches Jahr},
  symbol={$a_\text{trop}$},
  description={Ein tropisches Jahr ist die Zeit zwischen zwei gleichen Zeitpunkten im Ablauf der Jahreszeiten, \zb von einer Fr\"uhlings-Tagundnachtgleiche (Fr\"uhlingsanfang) zur n\"achsten.
Die L\"ange des tropischen Jahres betrug zu Beginn des Jahres 2000 (Epoche J2000) $365.24219052\:$d.
  }
}

@entry{wahreanomalie,
  name={Wahre Anomalie},
  symbol={$\upsilon$},
  description={Momentaner Winkel des Radiusvektors vom Zentralk\"orper (Erde \bzw Sonne im Brennpunkt der Bahnellipse) zum Satelliten \bzw Planeten, gez\"ahlt mathematisch positiv vom Perizentrum aus.
Neben dem Abstand zum Zentralk\"orper gibt sie die zweite Koordinate zur Beschreibung der Bewegung auf einer Kegelschnittbahn (\zb Ellipsenbahn) an.
  }
}

@entry{ut,
  name={Weltzeit \newline (Universal Time)},
  symbol={UT},
  description={Eine aus der Erddrehung abgeleitete Zeitz\"ahlung, die die Grundlage der b\"urgerlichen Zeitrechnung bildet.
Da die Erdrotation ungleichf\"ormigen Schwankungen unterworfen ist, bildet die Weltzeit keine kontinuierlich verlaufende Zeitz\"ahlung.
  }
}

@entry{zeitglg,
  name={Zeitgleichung},
  symbol={ZGL},
  description={Differenz zwischen der wahren Sonnenzeit (WOZ) und der mittleren Sonnenzeit (MOZ)}
}

@entry{zenit,
  name={Zenit},
  symbol={Z},
