@article{Umrigar2025,
    author = {Umrigar, C. J. and Anderson, Tyler A.},
    title = {Energy needed to propel a tiny spacecraft to Proxima Centauri},
    journal = {American Journal of Physics},
    volume = {93},
    number = {11},
    pages = {874-880},
    year = {2025},
    month = {11},
    abstract = {Conventional chemical rockets enable exploration of the entire solar system. However, exploration beyond the solar system on a human time scale requires new technology. The goal of the Breakthrough Starshot project, and one of the goals of the Starlight project, is to send a tiny 2 g spacecraft to the nearest star, Proxima Centauri, propelled by a light sail and powerful Earth-based lasers. We provide simple derivations of two different expressions for the laser energy required to propel the spacecraft, both of which have been published in the literature. One of these expressions is relevant to the mission and the other is not, and we invite the reader to think of the reason before providing the answer. In the appendix of this paper, we point out that one of the formulae in Einstein's amazing 1905 paper is correct only in certain limits, but Einstein fails to mention that. Although Einstein's formula results in a completely negligible error in the energy estimate for the Starshot/Starlight project, it has been incorrectly blamed for the differences in the published energy estimates.},
    issn = {0002-9505},
    doi = {10.1119/5.0263298},
    url = {https://doi.org/10.1119/5.0263298},
    eprint = {https://pubs.aip.org/aapt/ajp/article-pdf/93/11/874/20763490/874_1_5.0263298.pdf},
}


