@article{Müller2020,
    author = {Müller, Patric and Sack, Achim and Pöschel, Thorsten},
    title = "{Misconceptions about gyroscopic stabilization}",
    journal = {Am. J. Phys.},
    volume = {88},
    number = {3},
    pages = {175-181},
    year = {2020},
    month = {03},
    abstract = "{ A spinning gyroscope resists small torques in directions perpendicular to its axis, that is, the angular orientation of a body rigidly attached to a gyroscope is stable against rotation around certain axes. Since the angular orientation of a body is described by three angles (e.g., Euler angles), one might conclude that it is possible to stabilize the orientation of an object against rotation using a combination of three gyroscopes spinning around non-collinear axes. We perform experiments under conditions of weightlessness to demonstrate that systems of coupled gyroscopes cannot arrest the angular orientation of free-floating objects, in contradiction to a widespread myth about gyroscopic stabilization, based on the above arguments. }",
    issn = {0002-9505},
    doi = {10.1119/10.0000517},
    url = {https://doi.org/10.1119/10.0000517},
    eprint = {https://pubs.aip.org/aapt/ajp/article-pdf/88/3/175/13094617/175\_1\_online.pdf},
}

