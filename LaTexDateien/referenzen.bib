@article{Scheiger2023,
    author = {Scheiger, Philipp and Cartarius, Holger and Nawrodt, Ronny},
    title = "{Why and how to implement worked examples in upper division theoretical physics}",
    journal = {Am. J. Phys.},
    volume = {91},
