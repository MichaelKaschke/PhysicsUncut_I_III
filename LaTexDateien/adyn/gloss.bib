@entry{apogee,
  name={Apogäum},
  description={Erdfernster Punkt einer elliptischen Satellitenbahn (Griechisch/Neulatein apo - fern, geo - Erde).}
}

@entry{perigee,
  name={Perigäum},
  description={Erdnächster Punkt einer elliptischen Satellitenbahn (Griechisch/Neulatein peri - nah, geo - Erde).}
}
@entry{apheladyn,
  name={Aphel},
  description={Sonnenfernster Punkt einer elliptischen Bahn um die Sonne (Griechisch apo - fern, helios - Sonne).}
}

@entry{periheladyn,
  name={Perihel},
  description={Sonnennächster Punkt einer elliptischen Bahn um die Sonne (Griechisch/Neulatein peri - nah, helios - Sonne).}
}

@entry{orbit,
  name={Orbit},
  description={Mit Orbit (aus dem Lateinischen orbita (Bahn)) bezeichnet man in der Raumfahrt die Bahn eines Objektes um einen Himmelskörper.}
}

@entry{Oskulation,
  name={oskulierende Bahn},
  description={In der Himmelsmechanik und der Astrodynamik  bezeichnet man als oskulierende (\dh sich "anschmiegende") Bahn eines Himmelskörpers die Bahn die sich zu einem bestimmten Zeitpunkt (ihrer Epoche) möglichst genau an die wahre Bahn anschmiegt. Die oskulierende Bahn wird durch oskulierenden Bahnparameter beschrieben, die exakt nur für einen Moment (die Epoche) gelten. In der der Nähe der Epoche können mit oskulierenden Bahnparametern die wahren Bahnen sehr genau beschrieben werden, je weiter entfernt der Zeitpunkt von der Epoche ist, desto ungenauer wird die so berechnete Position.}
}

@entry{GEO,
  name={Geostationary Orbit},
  symbol={$\text{GEO}$},
  description={Die Kreisbahn eines exakt geostationären Satelliten liegt immer über dem Erdäquator. Die Bahnneigung zum äquator beträgt 0 Grad. Häufig werden aber auch annähernd geostationären Satelliten unter der Kategorie GEO eingeordnet.}
}

@entry{ToF,
  name={Time of Flight},
  symbol={$\text{ToF}$},
  description={Die Zeit, die ein Raumschiff oder ein anderer Himmelskörper auf einem Abschnitt einer Kepler-Bahn oder der Summe von Kepler-Bahnabschnitten braucht.}
}

@entry{SOI,
  name={Einflusssphäre},
  symbol={$\text{SOI}$},
  description={Mit Einflusssphäre eines Himmelskörpers (Planeten) (englisch Sphere of Influence) wird in der Astrodynamik der Bereich bezeichnet, in dem die Gravitation des Himmelskörpers (Planeten) im Sonnensystem Auswirkungen auf Raumsonden (oder andere Himmelskörper) hat, die in Rechnungen unbedingt mit einbezogen werden müssen. Au\ss{}erhalb der SOI wird der Einfluss des Himmelskörpers (Planeten) gegenüber der Gravitation der Sonne vernachlässigt.}
}

@entry{LEO,
  name={Lower Earth Orbit},
  symbol={$\text{LEO}$},
  description={LEO-Bahnen sind die energieärmsten Bahnen und damit am leichtesten zu erreichen. Für einen Umlauf um die Erde benötigen sie ca. 100 Minuten. Die Sichtbarkeit und damit der Funkkontakt zu einer Bodenstation beträgt höchstens 15 Minuten pro Umlauf. Sie haben zahlreiche Anwendungen.}
}

@entry{vkosmos,
  name={kosmische Geschwindigkeit},
  symbol={$v_\text{K}$},
  description={Die 1. kosmischen Geschwindigkeit $v_\text{K,1}=v_\text{K,E}=v_\text{K}=\SI{7.9}{\km\per\second}$ ist die Kreisbahngeschwindigkeit eines Objektes im niedrigen Orbit um die Erde. Für $v > v_\text{K,E}$ ist die Bahn eine Ellipse. Mit der 2. kosmischen Geschwindigkeit $v_\text{K,2}=v_\text{F,E}=\SI{11.2}{\km\per\second}$ des Raumflugkörpers öffnet sich die Bahn zu einer Kepler-Parabel, diese Geschwindigkeit heißt deswegen auch Fluchtgeschwindigkeit. Als 3. kosmische Geschwindigkeit wird die minimale Startgeschwindigkeit von der Erdoberfläche, mit der bei Ausnutzen der Bahngeschwindigkeit der Erde um die Sonne ($\SI{29.8}{\km\per\second}$) das Sonnensystem verlassen werden kann. Eine Sonde muss also das gemeinsame Gravitationsfeld von Erde und Sonne überwinden. Die 3. kosmische Geschwindigkeit berechnet sich dann aus der Fluchtgeschwindigkeit, die ein Körper haben muss, um das Sonnensystem zu verlassen ($\SI{42.1}{\km\per\second}$) zu $\SI{12.3}{\km\per\second}$. Um diese Geschwindigkeit zu erreichen, braucht es mindesten eine Startgeschwindigkeit von der Erdoberfläche von $\SI{16.61}{\km\per\second}$.}
}

@entry{vescape,
  name={Fluchtgeschwindigkeit},
  symbol={$v_\text{F}$},
  description={Als Fluchtgeschwindigkeit bezeichnet man die Geschwindigkeit, die ein Körper erlangen muss, damit seine kinetische Energie gerade ausreicht, um das Gravitationsfeld des Himmelskörpers (um den die Bewegung) stattfindet, zu verlassen ("zu entfliehen"). Die Fluchtgeschwindigkeit von der Erde heißt auch zweite kosmische Geschwindigkeit.}
}

@entry{GA,
  name={Gravity-Assist-Manöver},
  symbol={$\text{GA}$},
  description={Als Gravity-Assist-Manöver wird ein Element der Bahnplanung von Raumfahrzeugen bezeichnet, das deren Geschwindigkeit unter Ausnutzung des Gravitationsfeldes eines Himmelskörpers gezielt verändert.}
}

@entry{EGA,
  name={Earth-Gravity-Assist-Manöver},
  symbol={$\text{EGA}$},
  description={Ein Earth-Gravity-Assist-Manöver ist ein Gravity-Assit-Manöver im Schwerefeld der Erde.}
}

@entry{VGA,
  name={Venus-Gravity-Assist-Manöver},
  symbol={$\text{VGA}$},
  description={Ein Venus-Gravity-Assist-Manöver ist ein Gravity-Assist-Manöver im Schwerefeld der Venus.}
}

@entry{Korona,
  name={Korona},
  description={Bezeichnet einen Teil der Sonnenatmosphäre, auch Strahlenkranz um die Sonne (Lateinisch corona - Kranz).}
}

@entry{Sonnenwind,
  name={Sonnenwind},
  description={Als Sonnenwind bezeichnet man die in den Weltraum gerichtete, korpuskulare Strahlung der Sonne.}
}

@entry{HEO,
  name={Highly Elliptical Orbit},
  symbol={$\text{HEO}$},
  description={Highly-Elliptical-Orbit-Satelliten bewegen sich auf elliptischen Bahnen mit gro\ss{}er Exzentrizität, das hei\ss{}t gro\ss{}em Verhältnis von Perigäum und Apogäum. Typische Werte sind 2000 bis 15.000 km bzw. im Extremfall zwischen 50.000 bis 400.000 km. Hoch elliptische Erdorbits werden für Forschung, Telekommunikation und militärische Anwendungen verwendet.}
}

@entry{LM,
  name={Lunar Module},
  symbol={$\text{LM}$},
  description={Die Apollo-Mondlandefähre (ursprünglich LEM für Lunar Excursion Module) war ein ab 1963 für die NASA im Rahmen des Apollo-Programms entwickelter Lander zur Landung auf dem Mond. Die LM von Apollo 11 hatte den Namen "The Eagle".}
}

@entry{CSM,
  name={Command Service Module},
  symbol={$\text{CSM}$},
  description={Das Apollo-Raumschiff bestand aus dem Kommandomodul (CM) und dem Servicemodul (SM), die Kombination wurde Command Service Module genannt.}
}

@entry{thrust,
  name={Schubkraft},
  description={Bei Raketentriebwerken wird die Antriebskraft (Schubkraft) durch Aussto\ss{}en von Stützmasse entgegen der Antriebsrichtung erzeugt. Da dabei im Gegensatz zum Flugzeugtriebwerk keine Materie von au\ss{}en angesaugt und beschleunigt wird, funktionieren diese auch im Vakuum.}
}

@entry{payload,
  name={Payload},
  description={Englischer Fachbegriff für die Nutzlast eines Raumfahrzeugs.}
}

@entry{antriebsvermoegen,
  name={Antriebsvermögen},
	symbol={$\Delta v$},
  description={Geschwindigkeitsänderung $\Delta v$, die ein Raumschiff mit gegebener Masse durch ein Triebwerk mit einer gegebenen Treibstoff- und Strukturmasse und Ausströmgeschwindigkeit des Gases erreichen kann. Das Antriebsvermögen wird oft auch charakteristische Geschwindigkeit genannt.}
}

@entry{drag,
  name={Drag},
  description={Englischer Fachbegriff für Reibung, hier insbesondere durch die Restatmosphäre im Weltall hervorgerufen.}
}

@entry{Brennschluss,
  name={Brennschluss},
  description={Fachbegriff für das Ende der Brennphase einer Rakete bzw. Raketenstufe. In der englischen Fachsprache als Burn-Out bzeichnet.}
}

@entry{CWG,
  name={Clohessy-Wiltshire-Gleichungen},
  symbol={CW},
  description={Die Clohessy-Wiltshire-Gleichungen beschreiben die Bewegung eines Raumschiffs im Koordinatensystem des Targets, dem sich der Jäger annähern will.}
}

@entry{TPI,
  name={Terminal Phase Initiation},
  symbol={TPI},
  description={Englischer Fachbegriff, der den Beginn der finalen Phase eines Flugabschnittes beschreibt.}
}

@entry{CDH,
  name={Constant Delta Height},
  symbol={CDH},
  description={Englischer Fachbegriff, der das Manöver bezeichnet, welches eine Raumsonde auf eine Kreisbahn mit konstanter Höhe über den Zentralkörper bringt.}
}

@entry{CSI,
  name={Coelliptic Sequence Initiation},
  symbol={CSI},
  description={Englischer Fachbegriff, der das Manöver bezeichnet, welches das Lunar Module von Apollo 11 auf eine koelliptische Bahn mit dem Command Service Module brachte.}
}

@entry{TPF,
  name={Terminal Phase Finalization},
  symbol={TPF},
  description={Englischer Fachbegriff, der die Schlussphase eines Flugabschnittes, z.B. ein Bremsmanöver, beschreibt.}
}

@entry{rocketequ,
  name={Raketen-Gleichung},
  symbol={},
  description={Gibt die Geschwindigkeitsänderung im feien Raum über eine Brennphase des Triebwerkes mit konstanter Strahlgeschwindigkeit an. Diese Gleichung wird in der Literatur häufig auch als Ziolkowski-Gleichung bezeichnet.
  $\Delta v_\text{R} =  v_\text{G}\,\ln (m_\text{Startmasse}/m_\text{Endmasse}) $.
}
}

@entry{StrukturmassenVerhaeltnis,
  name={Strukturmassenverhältnis},
  symbol={$\sigma_S$},
  description={Gibt für mehrstufige Raketen das Verhältnis aller Massen au\ss{}er Nutzlast und Treibstoff bezogen auf die jeweilige Stufe an.}
}

@entry{OberthEffekt,
  name={Oberth-Effekt},
  symbol={},
  description={Ein Raumschiff kann bei einem Impulsmanöver etwas Energie zusätzlich zur chemischen Energie des Treibstoffs aufnehmen und zwar von der ursprünglichen kinetischen Energie, die der Treibstoff vor dem Zünden auf Grund der Bewegung der Rakete hatte.}
}

@entry{visvivaadyn,
  name={vis-viva-Gleichung},
  symbol={},
  description={Definiert die Beziehung zwischen Himmelskörperposition und seiner Bahngeschwindigkeit.}
}

@entry{gravparadyn,
  name={Gravitationsparameter},
  symbol={$\mu, \mu_\text{G}$},
  description={Produkt aus Gravitationskonstante $G$ und Masse $m$ des Zentralkörpers in einem Gravitationsproblem/Zweikörperproblem. Bezieht sich der Gravitationsparameter auf einen speziellen Himmelskörper, so schreibt man auch $\mu_\text{S}$ für die Sonne, oder  $\mu_\text{E}$ für die Erde. Als Einheiten sind $\SI{}{\metre\squared\per\second^3}$  oder $\SI{}{\au\squared\per d^3}$  gebräuchlich.}
}
@entry{AngleOfAttack,
  name={Angle of Attack},
  symbol={AoA},
  description={Winkel zwischen Schub und Geschwindigkeit der Rakete.}
}
@entry{FlightPathAngle,
  name={Flight Path Angle},
  symbol={FPA},
  description={Winkel zwischen Geschwindigkeit der Rakete und lokalem Horizont.}
}

@entry{jpladyn,
  name={Jet Propulsion Laboratory},
  symbol={JPL},
  description={Das namhafte JPL als Teil des California Institute of Technology führt Satelliten- und Raumsondenprojekte der US-amerikanischen National Aeronautics and Space Administration (NASA) durch. Dies umfasste zahlreiche Missionen wie Explorer, Viking, Voyager bis zuletzt Mars 2020 mit dem Preseverance Rover.}
}

