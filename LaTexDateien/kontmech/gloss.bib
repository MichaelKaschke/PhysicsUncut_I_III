@entry{viskositaet,
  name={Viskosit\"at},
  symbol={$\eta$},
  description={Eigenschaft der Fl\"ussigkeit oder des Gases, Reibungswiderstand gegen eine \"Anderung der Bewegung zu leisten.}
}

@entry{reynoldszahl,
  name={Reynolds-Zahl},
  symbol={Re},
  description={Dimensionslose Verh\"altniszahl, die bei Gr\"o\ss{}en\-skalierungen f\"ur identische Str\"omungsvorg\"ange konstant gehalten werden muss.}
}

@entry{Wirkungsfunktional,
  name={Wirkungsfunktional},
  symbol={$S$},
  description={Die Wirkung $S$ ist eine physikalische Gr\"o\ss e mit der Dimension Energie mal Zeit. Die Wirkung ist ein Funktional, das die physikalisch durchlaufenen Bahnen in der Menge aller denkbaren Bahnen auszeichnet. Die Bewegungsgleichungen der physikalisch durchlaufenen Bahnen besagen, dass bei festgehaltenem Anfangs- und Endpunkt im $x,p$-Phasenraum die Wirkung der tats\"achlich durchlaufenen physikalischen Bahn unter allen denkbaren Bahnen einen lokalen Extremwert (Minimum) annimmt. Diese Bedingung hei\ss t auch Prinzip der kleinsten Wirkung.}
}

@entry{Dispersionsrelation,
  name={Dispersionsrelation},
  symbol={},
  description={In der Physik beschreibt die Dispersionsrelation den Zusammenhang zwischen der Energie eines physikalischen Prozesses (gegeben durch Frequenz \bzw Energie) und den Prozessablauf beschreibenden Gr\"o\ss en wie Wellenzahl, der Ausbreitungsgeschwindigkeit u.\,a.). Mathematisch wird die Dis\-persions\-relation bei Wellen aus der linearen Wellengleichung durch eine Fourier-Transformation in Raum und Zeit gewonnen und hat die allgemeine Form:
	$\omega = f(k)$ \bzw $\omega = f(\lambda)$, worin $\omega$ die Kreisfrequenz des schwingenden, energetischen Systems ist.}
}

@entry{eulerscheKoordinaten,
  name={Euler-Koordinaten},
  symbol={},
  description={In der Kontinuumsmechanik ordnen Euler-Koordinaten jedem
  festen Materiepunkt $\vec{\hat{P}}$ zu jedem Zeitpunkt $t$ einen Ort $\vec{r}$
  zu. Sie geben also an, wo sich ein Materiepunkt befindet, $\vec{r}
  (\vec{\hat{P}},t)$.}
}

@entry{lagrangescheKoordinaten,
  name={Lagrange-Koordinaten},
  symbol={},
  description={Lagrange-Koordinaten geben an, welcher Materiepunkt
  $\vec{\hat{P}}$ sich zu einer bestimmten Zeit $t$ an einem bestimmten Ort $\vec{r}$
  befindet, $\vec{\hat{P}}(\vec{r},t)$.}
}

@entry{Bahnlinie,
  name={Bahnlinie},
  symbol={},
  description={In einem Str\"omungsfeld gibt eine Bahnlinie eine Ortskurve an,
  die ein Materiepunkt mit der Zeit tats\"achlich durchl\"auft.}
}

@entry{Stromlinie,
  name={Stromlinie},
  symbol={},
  description={Als Stromlinie in einem Str\"omungsfeld bezeichnet man eine
  Linie, die zu einem festen Zeitpunkt an jedem ihrer Punkte tangential an
  das Geschwindigkeitsfeld anliegt.}
}

@entry{PDGL,
  name={partielle Differentialgleichung},
  symbol={},
  description={Im Gegensatz zu einer gew\"ohnlichen Differential\-gleichung,
  bei der nur eine unabh\"angige Ver\"anderliche auftritt, nach der abgeleitet
  werden kann, besitzen partielle Differentialgleichungen mehrere unabh\"angige
  Ver\"anderliche.}
}

@entry{Elastizitaetsmodul,
  name={Elastizit\"atsmodul},
  symbol={$E$},
  description={Ein Elastizit\"atsmodul gibt an, welche Zugspannung $\sigma$
  n\"otig ist, um bei einem elastischen festen K\"orper die relative
  L\"angen\"anderung $\Delta \ell/\ell$ zu bewirken,
  $E=\sigma/(\Delta \ell/\ell)$.}
}

@entry{Poissonzahl,
  name={Poissonzahl},
  symbol={$\nu$},
  description={Die Poissonzahl gibt an, wie sehr sich ein K\"orper verk\"urzt,
  wenn er in einer Richtung senkrecht dazu gestreckt wird. Sie ergibt sich
  dadruch, dass die relative Verk\"urzung $-\Delta a/a$ durch die relative
  Streckung $\Delta \ell/\ell$ geteilt wird, $\nu = (-\Delta a/a)/(\Delta
  \ell/\ell)$.}
}

@entry{Schubmodul,
  name={Schubmodul},
  symbol={$G$},
  description={Ein Schubmodul, auch Torsionsmodul genannt, gibt an, welche
  Scherspannung $\tau$, die tangential an eine Fl\"ache des K\"orpers anliegt,
  n\"otig ist, um eine Scherung um den Winkel $\alpha$ zu bewirken (vgl.
  \figref{kontmech_ElastTorsion}(b)), $G=\tau/\alpha$.}
}

@entry{Phasengeschwindigkeit,
  name={Phasengeschwindigkeit},
  symbol={$v_\mathrm{ph}$},
  description={Die Phasengeschwindigkeit gibt an, mit welcher Geschwindigkeit
  sich ein Punkt konstanter Phase einer Welle bewegt. Für eine Sinuswelle
  der Form $y(x,t)=A\sin(\omega t - k x + \varphi_0)$ können wir
  beispielsweise eine Phase $\psi = \omega t - k x + \varphi_0 = \mathrm{const}$
  herausgreifen. Ableiten nach der Zeit liefert $\omega = k v_\mathrm{ph}$ oder
  $v_\mathrm{ph} = \omega/k$.}
}
